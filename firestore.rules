rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Filet de sécurité global (refus par défaut)
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 120
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidHistoryEntry(data, userId, entryId) {
      return data.keys().hasAll(['id', 'userId', 'fileName', 'toolId', 'toolTitle', 'sizeFormatted', 'processedAt', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'fileName', 'toolId', 'toolTitle', 'sizeFormatted', 'processedAt', 'createdAt'])
        && data.id is string
        && data.id == entryId
        && isValidId(data.id)
        && data.userId is string
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.fileName is string
        && data.fileName.size() >= 1
        && data.fileName.size() <= 255
        && data.toolId is string
        && data.toolId.size() >= 1
        && data.toolId.size() <= 40
        && data.toolId.matches('^[a-z0-9_\\-]+$')
        && data.toolTitle is string
        && data.toolTitle.size() >= 1
        && data.toolTitle.size() <= 120
        && data.sizeFormatted is string
        && data.sizeFormatted.size() >= 1
        && data.sizeFormatted.size() <= 40
        && data.processedAt is number
        && data.processedAt > 0
        && data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']);
      allow delete: if isValidId(userId) && isOwner(userId);

      match /private/{infoId} {
        allow get: if isValidId(userId) && isValidId(infoId) && isOwner(userId);
        allow list: if false;
        allow create: if isValidId(userId)
          && isValidId(infoId)
          && infoId == 'info'
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidId(infoId)
          && infoId == 'info'
          && isOwner(userId)
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(infoId) && isOwner(userId);
      }

      match /history/{entryId} {
        allow get: if isValidId(userId)
          && isValidId(entryId)
          && isOwner(userId)
          && existing().userId == request.auth.uid;
        allow list: if isSignedIn()
          && isValidId(userId)
          && request.auth.uid == userId
          && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(entryId)
          && isOwner(userId)
          && isValidHistoryEntry(incoming(), userId, entryId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
        allow update: if false;
        allow delete: if isValidId(userId)
          && isValidId(entryId)
          && isOwner(userId)
          && existing().userId == request.auth.uid;
      }
    }
  }
}
