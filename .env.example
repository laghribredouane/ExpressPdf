# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this applet is hosted (no 302 redirect).
APP_URL="https://pdfexpress.ai.studio"

# Google AdSense (affiché uniquement dans la version gratuite, supprimé en Premium / Essai 7j)
VITE_ADSENSE_CLIENT_ID="ca-pub-7807016100432800"
VITE_ADSENSE_SLOT_HOME=""
VITE_ADSENSE_SLOT_WORKSPACE=""
VITE_ADSENSE_SLOT_RESULT=""
